<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_auth_header" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_rounded_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.65">

        <TextView
            android:id="@+id/tvResetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="RESET"
            android:textColor="#3E2723"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/edtEmailForgot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="40dp"
            android:background="@null"
            android:hint="Email"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/tvResetTitle" />
            
        <TextView
            android:id="@+id/tvSendCodeForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi mã"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/edtEmailForgot"
            app:layout_constraintEnd_toEndOf="@+id/edtEmailForgot" />

        <View
            android:id="@+id/lineEmail"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#A6A6A6"
            app:layout_constraintEnd_toEndOf="@+id/edtEmailForgot"
            app:layout_constraintStart_toStartOf="@+id/edtEmailForgot"
            app:layout_constraintTop_toBottomOf="@+id/edtEmailForgot" />

        <EditText
            android:id="@+id/edtVerificationCodeForgot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:background="@null"
            android:hint="Mã xác minh"
            android:inputType="number"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/lineEmail" />

        <View
            android:id="@+id/lineCode"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#A6A6A6"
            app:layout_constraintEnd_toEndOf="@+id/edtVerificationCodeForgot"
            app:layout_constraintStart_toStartOf="@+id/edtVerificationCodeForgot"
            app:layout_constraintTop_toBottomOf="@+id/edtVerificationCodeForgot" />

        <Button
            android:id="@+id/btnVerifyForgot"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#4E342E"
            android:text="Xác minh"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:layout_constraintTop_toBottomOf="@+id/lineCode" />

        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="32dp"
            android:text="Đăng ký"
            android:textColor="#000000"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="32dp"
            android:text="Đăng nhập"
            android:textColor="#000000"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>