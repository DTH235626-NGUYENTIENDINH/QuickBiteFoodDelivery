<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5EDD8">

    <!-- Topbar -->

    <!-- Filter chip -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/red_accent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Quản lý đơn hàng"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="@+id/btnBack"
            app:layout_constraintVertical_bias="0.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/chipAll"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tất cả"    android:textSize="11sp" android:textColor="#FFFFFF" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip_active"/>
            <TextView android:id="@+id/chipPending"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chờ"       android:textSize="11sp" android:textColor="#777777" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip_inactive"/>
            <TextView android:id="@+id/chipConfirmed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xác nhận"  android:textSize="11sp" android:textColor="#777777" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip_inactive"/>
            <TextView android:id="@+id/chipDelivering" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giao"      android:textSize="11sp" android:textColor="#777777" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip_inactive"/>
            <TextView android:id="@+id/chipDone"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xong"      android:textSize="11sp" android:textColor="#777777" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip_inactive"/>
            <TextView android:id="@+id/chipCancelled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hủy"       android:textSize="11sp" android:textColor="#777777" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:background="@drawable/bg_chip_inactive"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Danh sách đơn -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:clipToPadding="false"/>

</LinearLayout>