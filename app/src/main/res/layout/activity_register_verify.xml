<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header common -->
    <include
        android:id="@+id/layoutAuthHeader"
        layout="@layout/layout_auth_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.42"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Rounded Form -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutWhiteForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_rounded_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAuthHeader">

        <!-- Tiêu đề SIGN UP -->
        <TextView
            android:id="@+id/tvVerifyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="SIGN UP"
            android:textColor="#3E2723"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Email Verify -->
        <EditText
            android:id="@+id/edtEmailVerify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:hint="Email"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/tvVerifyTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvSendcode" />

        <TextView
            android:id="@+id/tvSendcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:text="Gửi mã"
            android:textColor="#4E342E"
            android:textStyle="bold"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/edtEmailVerify"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edtEmailVerify" />

        <View
            android:id="@+id/lineEmailVerify"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#A6A6A6"
            app:layout_constraintTop_toBottomOf="@id/edtEmailVerify"
            app:layout_constraintStart_toStartOf="@id/edtEmailVerify"
            app:layout_constraintEnd_toEndOf="@id/tvSendcode" />

        <!-- Mã xác minh -->
        <EditText
            android:id="@+id/edtVerificationCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:background="@null"
            android:hint="Mã xác minh"
            android:inputType="number"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/lineEmailVerify" />

        <View
            android:id="@+id/lineVerificationCode"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#A6A6A6"
            app:layout_constraintTop_toBottomOf="@id/edtVerificationCode"
            app:layout_constraintStart_toStartOf="@id/edtVerificationCode"
            app:layout_constraintEnd_toEndOf="@id/edtVerificationCode" />

        <!-- Nút Xác minh -->
        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#4E342E"
            android:text="Xác minh"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/lineVerificationCode" />

        <!-- Footer link -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Đã có tài khoản? Đăng nhập"
            android:textColor="#555555"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>