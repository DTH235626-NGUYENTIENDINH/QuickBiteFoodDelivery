<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <!-- Topbar -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7B1F1F"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quản lý món ăn"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnAddFood"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="+ Thêm"
            android:textSize="12sp"
            android:textColor="#7B1F1F"
            android:backgroundTint="#F5C842"
            app:cornerRadius="16dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Thanh tìm kiếm -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/background_search"
                    app:tint="#BBBBBB"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Tìm kiếm món ăn..."
                    android:textSize="13sp"
                    android:singleLine="true"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Filter category -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <TextView android:id="@+id/chipAll"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tất cả"  android:padding="6dp" android:paddingHorizontal="14dp" android:background="@drawable/bg_chip_active"   android:textColor="#FFFFFF"  android:textSize="11sp" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/chipPizza"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pizza"   android:padding="6dp" android:paddingHorizontal="14dp" android:background="@drawable/bg_chip_inactive" android:textColor="#777777" android:textSize="11sp" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/chipBurger"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Burger"  android:padding="6dp" android:paddingHorizontal="14dp" android:background="@drawable/bg_chip_inactive" android:textColor="#777777" android:textSize="11sp" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/chipDrink"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drink"   android:padding="6dp" android:paddingHorizontal="14dp" android:background="@drawable/bg_chip_inactive" android:textColor="#777777" android:textSize="11sp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Danh sách món ăn -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFoodList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>