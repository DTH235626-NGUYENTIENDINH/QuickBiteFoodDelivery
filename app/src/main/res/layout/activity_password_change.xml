<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/PasswordChange"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".secondary_profile_activity.PasswordChangeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#8B1E1E">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="8dp"
                android:text="Cài đặt"
                android:textColor="#ffffff"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imgArrowBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="0.579"
                app:srcCompat="@mipmap/ic_arrowback"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvChangePass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đổi mật khẩu"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:textSize="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgPass1"
                android:layout_width="346dp"
                android:layout_height="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvChangePass"
                app:srcCompat="@drawable/img_txtpassworkchange" />

            <EditText
                android:id="@+id/txtMatKhauCu"
                android:layout_width="326dp"
                android:layout_height="60dp"
                android:ems="10"
                android:inputType="textVisiblePassword"
                android:text=""
                android:hint="Mật khẩu cũ"
                android:background="@null"
                app:layout_constraintBottom_toBottomOf="@+id/imgPass1"
                app:layout_constraintEnd_toEndOf="@+id/imgPass1"
                app:layout_constraintStart_toStartOf="@+id/imgPass1"
                app:layout_constraintTop_toTopOf="@+id/imgPass1" />

            <ImageView
                android:id="@+id/imgPass2"
                android:layout_width="346dp"
                android:layout_height="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgPass1"
                app:srcCompat="@drawable/img_txtpassworkchange" />

            <EditText
                android:id="@+id/txtMatKhauMoi"
                android:layout_width="326dp"
                android:layout_height="60dp"
                android:ems="10"
                android:inputType="textVisiblePassword"
                android:text=""
                android:hint="Mật khẩu mới"
                android:background="@null"
                app:layout_constraintBottom_toBottomOf="@+id/imgPass2"
                app:layout_constraintEnd_toEndOf="@+id/imgPass2"
                app:layout_constraintStart_toStartOf="@+id/imgPass2"
                app:layout_constraintTop_toTopOf="@+id/imgPass2" />

            <ImageView
                android:id="@+id/imgPass3"
                android:layout_width="346dp"
                android:layout_height="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgPass2"
                app:srcCompat="@drawable/img_txtpassworkchange" />

            <EditText
                android:id="@+id/txtMatKhauXacNhan"
                android:layout_width="326dp"
                android:layout_height="60dp"
                android:ems="10"
                android:inputType="textVisiblePassword"
                android:text=""
                android:hint="Xác nhận mật khẩu mới"
                android:background="@null"
                app:layout_constraintBottom_toBottomOf="@+id/imgPass3"
                app:layout_constraintEnd_toEndOf="@+id/imgPass3"
                app:layout_constraintStart_toStartOf="@+id/imgPass3"
                app:layout_constraintTop_toTopOf="@+id/imgPass3" />

            <Button
                android:id="@+id/btnLuu"
                android:layout_width="358dp"
                android:layout_height="60dp"
                android:text="Lưu mật kẩu"
                android:textSize="20dp"
                android:backgroundTint="#FFB300"
                android:textColor="#000000"
                app:cornerRadius="10dp"
                android:layout_marginBottom="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>